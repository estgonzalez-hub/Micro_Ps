# Pin assignments from Jacquard FPGA Studio.
# Edit this file, or the pin table on the Build screen: they are two views of one thing.
# Uploading the .zip this came in restores the pins, the board and the design top.
# jacquard-board: upduino-v3.1
# jacquard-top: top
set_io -nowarn a1 46
set_io -nowarn a2 45
set_io -nowarn cols[0] 11
set_io -nowarn cols[1] 19
set_io -nowarn cols[2] 21
set_io -nowarn cols[3] 10
set_io -nowarn enable 34
set_io -nowarn reset 43
set_io -nowarn row[0] 6
set_io -nowarn row[1] 4
set_io -nowarn row[2] 48
set_io -nowarn row[3] 47
set_io -nowarn seg[0] 44
set_io -nowarn seg[1] 3
set_io -nowarn seg[2] 13
set_io -nowarn seg[3] 12
set_io -nowarn seg[4] 20
set_io -nowarn seg[5] 9
set_io -nowarn seg[6] 18
